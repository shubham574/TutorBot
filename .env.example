# ==============================================================================
# TutorBot Environment Configuration
# Copy this file to .env and fill in the values
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# WhatsApp Cloud API Configuration
# Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAG...your_system_user_or_temporary_token
WHATSAPP_APP_SECRET=your_meta_app_secret_for_webhook_signature_verification
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Operational Mode
# When DRY_RUN=true, outbound WhatsApp messages are logged instead of sent to Meta API
DRY_RUN=true

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://tutorbot:tutorbot_secret@localhost:5432/tutorbot_db
# For Alembic migrations (synchronous driver)
SYNC_DATABASE_URL=postgresql://tutorbot:tutorbot_secret@localhost:5432/tutorbot_db

# Redis & Async Worker (ARQ)
REDIS_URL=redis://localhost:6379/0

# Storage (S3 / MinIO) - Used for syllabus documents and generated exam PDFs
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=tutorbot-documents
S3_REGION=us-east-1

# LLM Providers (Interfaces in app/services/llm)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Langfuse Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false
